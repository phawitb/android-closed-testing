NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed to apply the SQL migration (psql). Not read by the app.
SUPABASE_DB_URL=

# Only needed for seeding test users locally. Not read by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test or live), server-only — never put the Secret Key anywhere
# else. The Publishable Key is admin-configurable from /admin/settings
# instead of an env var; checkout only turns on once both are set.
STRIPE_SECRET_KEY=
# Optional safety net for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Resend (optional). Without these, payment/submission/completion emails are
# skipped — the app keeps working, it just won't send mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Closed Testing <onboarding@resend.dev>
